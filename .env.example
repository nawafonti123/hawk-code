# HAWK Code — never commit a real credential.
HAWK_LOG_LEVEL=info

# Qwen / Alibaba Cloud Model Studio. The API key can instead be stored from
# Settings → Qwen in Windows Credential Manager.
QWEN_API_KEY=YOUR_NEW_QWEN_API_KEY
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.7-max

# Modal / HAWK AI. The token is stored in Windows Credential Manager from
# Settings; these values are only deployment/configuration documentation.
MODAL_ENDPOINT_URL=
MODAL_PROXY_TOKEN=
HAWK_MODEL_ID=qwen3-coder-30b-a3b-instruct

# Public Google OAuth client identifier for the native desktop build. This is
# not a client secret. Put the real value in apps/desktop/src-tauri/.env.local.
HAWK_GOOGLE_OAUTH_CLIENT_ID=
HAWK_GOOGLE_OAUTH_CLIENT_SECRET=
