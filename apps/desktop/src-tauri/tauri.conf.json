{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAWK Code",
  "version": "0.1.0",
  "identifier": "com.hawkstudio.code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HAWK Code",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0D0E0C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI Engineering Command Center",
    "longDescription": "HAWK Code is a permissioned and evidence-driven AI engineering command center by HAWK Studio.",
    "copyright": "Copyright © 2026 HAWK Studio",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hawk-code.db"]
    }
  }
}
